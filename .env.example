# Kopiera den här filen till .env.local och fyll i värdena.
# .env.local laddas aldrig upp till GitHub. Dela aldrig nycklarna med någon.
# Variabler som börjar med NEXT_PUBLIC_ syns i webbläsaren – lägg aldrig hemligheter där.

# --- Sajten ---
# Adressen där sajten ligger. Lokalt: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (delmål 2) ---
# Din personliga token från supabase.com/dashboard/account/tokens. HEMLIG.
# Behövs bara för  npm run databas , som fyller i resten av Supabase-raderna åt dig.
SUPABASE_ACCESS_TOKEN=
# Fylls i automatiskt av  npm run databas :
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# HEMLIG. Används bara på servern och i skript.
SUPABASE_SECRET_KEY=

# Sätt till 1 när du har kopplat en egen e-posttjänst (SMTP) i Supabase.
# Då uppdaterar  npm run databas  inloggningsmejlen så att länkarna fungerar i alla webbläsare.
SUPABASE_CUSTOM_SMTP=

# --- Admin (delmål 2) ---
# E-postadresser som får logga in på /admin. Flera separeras med komma.
ADMIN_EMAILS=kevinjobb09@gmail.com

# --- Claude API (delmål 2 och 8) ---  console.anthropic.com > API Keys
# HEMLIG. Används bara i skripten i mappen scripts/, aldrig på sajten.
ANTHROPIC_API_KEY=

# --- Stripe ---  dashboard.stripe.com > Developers > API keys
# Använd testnycklar (sk_test_...) tills allt fungerar.
STRIPE_SECRET_KEY=
# Från Stripe: Developers > Webhooks > din endpoint > Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=

# --- Lansering ---  används bara av  npm run lansera
# Netlify → User settings → OAuth → New access token. HEMLIG.
NETLIFY_AUTH_TOKEN=
# Projektets namn på Netlify.
NETLIFY_SITE_NAME=asbra-prov
# Domänen du har köpt, t.ex. dindoman.se
LANSERING_DOMAN=
# Stripe live-nyckel (sk_live_...) från det riktiga Stripe-kontot. HEMLIG. Lämna tom för testläge.
STRIPE_LIVE_SECRET_KEY=
