# Kopiera den här filen till .env.local och fyll i värdena.
# .env.local laddas aldrig upp till GitHub. Dela aldrig nycklarna med någon.
# Variabler som börjar med NEXT_PUBLIC_ syns i webbläsaren – lägg aldrig hemligheter där.

# --- Sajten ---
# Adressen där sajten ligger. Lokalt: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (delmål 2) ---
# Din personliga token från supabase.com/dashboard/account/tokens. HEMLIG.
# Behövs bara för  npm run databas , som fyller i resten av Supabase-raderna åt dig.
SUPABASE_ACCESS_TOKEN=
# Fylls i automatiskt av  npm run databas :
SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# HEMLIG. Används bara på servern och i skript.
SUPABASE_SECRET_KEY=

# --- Admin (delmål 2) ---
# E-postadresser som får logga in på /admin. Flera separeras med komma.
ADMIN_EMAILS=kevinjobb09@gmail.com

# --- Claude API (delmål 2 och 8) ---  console.anthropic.com > API Keys
# HEMLIG. Används bara i skripten i mappen scripts/, aldrig på sajten.
ANTHROPIC_API_KEY=

# --- Stripe (delmål 7) ---  dashboard.stripe.com > Developers > API keys
# Använd testnycklar (sk_test_...) tills allt fungerar.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
